{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/magical-language-spec/schemas/semantic-registry-contracts.schema.json",
  "title": "SemanticRegistry Domain Contracts",
  "description": "Domain-local serialization of contracts already defined by reference/registry.md. Common identifiers, revisions, and SI dimensions use common-values.schema.json; opaque executable or domain-owned model values remain explicit extension boundaries.",
  "$defs": {
    "identifier": {"$ref": "common-values.schema.json#/$defs/identifier"},
    "revision": {
      "$ref": "artifact-metadata.schema.json#/$defs/revision"
    },
    "identifierArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/identifier"},
      "uniqueItems": true
    },
    "contractObject": {
      "type": "object",
      "description": "Structured domain contract whose inner vocabulary remains owned by its current reference or implementation/profile definition."
    },
    "encodedValue": {
      "description": "Structured value owned by the referenced domain contract. This extension point is not a common Quantity and must not be interpreted as one implicitly."
    },
    "extensions": {
      "type": "object",
      "description": "Explicit extension point. Extensions do not acquire semantics merely by being present."
    },
    "SemanticEntryContract": {
      "type": "object",
      "required": [
        "category",
        "traits",
        "allowed_modes",
        "endpoint_requirements",
        "observer_properties"
      ],
      "properties": {
        "category": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "dimension": {"$ref": "common-values.schema.json#/$defs/siDimension"},
        "payload_type": {"$ref": "#/$defs/identifier"},
        "traits": {"$ref": "#/$defs/identifierArray"},
        "conservation_profile": {"$ref": "#/$defs/identifierArray"},
        "allowed_modes": {"$ref": "#/$defs/identifierArray"},
        "endpoint_requirements": {"$ref": "#/$defs/contractObject"},
        "observer_properties": {"$ref": "#/$defs/identifierArray"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "SpeciesEntryContract": {
      "type": "object",
      "required": ["nuclide_composition", "net_charge", "aliases"],
      "properties": {
        "nuclide_composition": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/encodedValue"}
        },
        "net_charge": {"$ref": "#/$defs/encodedValue"},
        "topology": {"$ref": "#/$defs/contractObject"},
        "aliases": {"$ref": "#/$defs/identifierArray"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "StructureSchemaEntryContract": {
      "type": "object",
      "required": [
        "data_contract",
        "compatible_transfer_capabilities",
        "compatible_reconfigure_domains"
      ],
      "properties": {
        "data_contract": {"$ref": "#/$defs/contractObject"},
        "compatible_transfer_capabilities": {"$ref": "#/$defs/identifierArray"},
        "compatible_reconfigure_domains": {"$ref": "#/$defs/identifierArray"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "rationalCoefficient": {
      "type": ["number", "string"],
      "description": "Dimensionless stoichiometric rational. A string preserves an exact rational lexical form; this is not a physical Quantity encoding."
    },
    "stoichiometry": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/rationalCoefficient"}
    },
    "ReactionRuleEntryContract": {
      "type": "object",
      "required": [
        "stoichiometry",
        "domain",
        "required_state",
        "products",
        "accounting_profile",
        "authority_requirements",
        "pathway_ids"
      ],
      "properties": {
        "stoichiometry": {"$ref": "#/$defs/stoichiometry"},
        "domain": {"$ref": "#/$defs/identifier"},
        "required_state": {"$ref": "#/$defs/contractObject"},
        "products": {"$ref": "#/$defs/identifierArray"},
        "accounting_profile": {"$ref": "#/$defs/identifierArray"},
        "authority_requirements": {"$ref": "#/$defs/contractObject"},
        "default_kinetic_models": {"$ref": "#/$defs/identifierArray"},
        "default_equilibrium_model": {"$ref": "#/$defs/identifier"},
        "pathway_ids": {"$ref": "#/$defs/identifierArray"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "RateLaw": {
      "type": "object",
      "required": ["input_contract", "parameter_set", "valid_domain", "evaluate"],
      "properties": {
        "input_contract": {"$ref": "#/$defs/contractObject"},
        "parameter_set": {"$ref": "#/$defs/contractObject"},
        "valid_domain": {"$ref": "#/$defs/contractObject"},
        "evaluate": {"$ref": "#/$defs/contractObject"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "KineticModelEntryContract": {
      "type": "object",
      "required": [
        "reaction_rule_id",
        "rate_basis",
        "rate_law",
        "input_contract",
        "valid_domain"
      ],
      "properties": {
        "reaction_rule_id": {"$ref": "#/$defs/identifier"},
        "rate_basis": {"$ref": "#/$defs/identifier"},
        "rate_law": {"$ref": "#/$defs/RateLaw"},
        "rate_constant_model": {"$ref": "#/$defs/contractObject"},
        "input_contract": {"$ref": "#/$defs/contractObject"},
        "valid_domain": {"$ref": "#/$defs/contractObject"},
        "uncertainty_model": {"$ref": "#/$defs/contractObject"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "ElementaryStep": {
      "type": "object",
      "required": [
        "id",
        "stoichiometry",
        "reversible",
        "kinetic_model_id",
        "intermediates",
        "accounting_profile",
        "revision"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "stoichiometry": {"$ref": "#/$defs/stoichiometry"},
        "reversible": {"type": "boolean"},
        "kinetic_model_id": {"$ref": "#/$defs/identifier"},
        "intermediates": {"$ref": "#/$defs/identifierArray"},
        "accounting_profile": {"$ref": "#/$defs/identifierArray"},
        "revision": {"$ref": "#/$defs/revision"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "ReactionPathwayEntryContract": {
      "type": "object",
      "required": [
        "overall_rule_id",
        "steps",
        "kinetic_model_id",
        "catalyst_requirements",
        "valid_domain",
        "accounting_profile"
      ],
      "properties": {
        "overall_rule_id": {"$ref": "#/$defs/identifier"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ElementaryStep"}
        },
        "kinetic_model_id": {"$ref": "#/$defs/identifier"},
        "catalyst_requirements": {"$ref": "#/$defs/contractObject"},
        "valid_domain": {"$ref": "#/$defs/contractObject"},
        "accounting_profile": {"$ref": "#/$defs/identifierArray"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "CatalystModelEntryContract": {
      "type": "object",
      "required": [
        "requirement_contract",
        "affected_pathways",
        "kinetic_modifiers",
        "state_model",
        "recovery_condition",
        "valid_domain"
      ],
      "properties": {
        "requirement_contract": {"$ref": "#/$defs/contractObject"},
        "affected_pathways": {"$ref": "#/$defs/identifierArray"},
        "kinetic_modifiers": {"$ref": "#/$defs/contractObject"},
        "state_model": {"$ref": "#/$defs/contractObject"},
        "recovery_condition": {"$ref": "#/$defs/contractObject"},
        "valid_domain": {"$ref": "#/$defs/contractObject"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "InhibitorModelEntryContract": {
      "type": "object",
      "required": ["extension"],
      "properties": {
        "extension": {
          "$ref": "#/$defs/extensions",
          "description": "The current reference only establishes an independent InhibitorModel namespace. Its domain fields remain explicitly unspecified."
        }
      },
      "additionalProperties": false
    },
    "ActivityModelEntryContract": {
      "type": "object",
      "required": [
        "species_domain",
        "phase_contract",
        "standard_state",
        "evaluate_activity",
        "valid_domain"
      ],
      "properties": {
        "species_domain": {"$ref": "#/$defs/identifierArray"},
        "phase_contract": {"$ref": "#/$defs/contractObject"},
        "standard_state": {"$ref": "#/$defs/contractObject"},
        "evaluate_activity": {"$ref": "#/$defs/contractObject"},
        "valid_domain": {"$ref": "#/$defs/contractObject"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "EquilibriumModelEntryContract": {
      "type": "object",
      "required": [
        "reaction_rule_id",
        "activity_model_id",
        "standard_state",
        "evaluate_K",
        "valid_domain",
        "tolerance_policy"
      ],
      "properties": {
        "reaction_rule_id": {"$ref": "#/$defs/identifier"},
        "activity_model_id": {"$ref": "#/$defs/identifier"},
        "standard_state": {"$ref": "#/$defs/contractObject"},
        "evaluate_K": {"$ref": "#/$defs/contractObject"},
        "valid_domain": {"$ref": "#/$defs/contractObject"},
        "tolerance_policy": {"$ref": "#/$defs/contractObject"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "ObserverModelEntryContract": {
      "type": "object",
      "required": [
        "input_type",
        "output_type",
        "domain",
        "response",
        "normalization"
      ],
      "properties": {
        "input_type": {"$ref": "#/$defs/identifier"},
        "output_type": {"$ref": "#/$defs/identifier"},
        "domain": {"$ref": "#/$defs/contractObject"},
        "response": {"$ref": "#/$defs/contractObject"},
        "normalization": {"$ref": "#/$defs/contractObject"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "EvidenceFusionModelEntryContract": {
      "type": "object",
      "required": [
        "model_kind",
        "accepted_measurement_types",
        "hypothesis_schema",
        "source_independence_treatment",
        "conflict_policy",
        "scoring_calibration",
        "uncertainty_output",
        "minimum_evidence_policy",
        "valid_domain",
        "deterministic_tie_break",
        "provenance"
      ],
      "properties": {
        "model_kind": {"const": "EvidenceFusionModel"},
        "accepted_measurement_types": {"$ref": "#/$defs/identifierArray"},
        "hypothesis_schema": {"$ref": "#/$defs/contractObject"},
        "source_independence_treatment": {"$ref": "#/$defs/contractObject"},
        "conflict_policy": {"$ref": "#/$defs/contractObject"},
        "scoring_calibration": {"$ref": "#/$defs/contractObject"},
        "uncertainty_output": {"$ref": "#/$defs/contractObject"},
        "minimum_evidence_policy": {"$ref": "#/$defs/contractObject"},
        "valid_domain": {"$ref": "#/$defs/contractObject"},
        "deterministic_tie_break": {"$ref": "#/$defs/contractObject"},
        "provenance": {"$ref": "#/$defs/contractObject"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "ControllerModelEntryContract": {
      "type": "object",
      "required": [
        "model_kind",
        "observation_input_contract",
        "controller_error_model",
        "permitted_actuator_effects",
        "valid_domain",
        "resource_accounting_profile",
        "timing_contract",
        "saturation_overload",
        "termination",
        "required_capability_lease",
        "provenance"
      ],
      "properties": {
        "model_kind": {"const": "BoundaryReflectionController"},
        "observation_input_contract": {"$ref": "#/$defs/contractObject"},
        "controller_error_model": {"$ref": "#/$defs/contractObject"},
        "permitted_actuator_effects": {"$ref": "#/$defs/identifierArray"},
        "valid_domain": {"$ref": "#/$defs/contractObject"},
        "resource_accounting_profile": {"$ref": "#/$defs/contractObject"},
        "timing_contract": {"$ref": "#/$defs/contractObject"},
        "saturation_overload": {"$ref": "#/$defs/contractObject"},
        "termination": {"$ref": "#/$defs/contractObject"},
        "required_capability_lease": {"$ref": "#/$defs/contractObject"},
        "provenance": {"$ref": "#/$defs/contractObject"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "ConservationLedgerEntryContract": {
      "type": "object",
      "required": ["semantic_type", "balance_rule", "applicable_domains"],
      "properties": {
        "semantic_type": {"$ref": "#/$defs/identifier"},
        "balance_rule": {"$ref": "#/$defs/contractObject"},
        "applicable_domains": {"$ref": "#/$defs/identifierArray"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    }
  }
}
