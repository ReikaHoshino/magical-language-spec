{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/magical-language-spec/schemas/golden-parity-manifest.schema.json",
  "title": "GoldenParityManifest-0",
  "type": "object",
  "required": ["manifest_version", "suite_id", "stability", "ownership_policy", "templates", "cases"],
  "properties": {
    "manifest_version": {"const": "0"},
    "suite_id": {"type": "string", "minLength": 1},
    "stability": {"const": "experimental"},
    "ownership_policy": {
      "type": "object",
      "required": ["expected_truth_owner", "executable_input_is_not_oracle", "identity_fields", "subset_fields"],
      "properties": {
        "expected_truth_owner": {"type": "string", "minLength": 1},
        "executable_input_is_not_oracle": {"const": true},
        "identity_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "subset_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "#/$defs/check"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "pointer": {
      "type": "string",
      "pattern": "^(?:|(?:/(?:[^/~]|~0|~1)*)+)$"
    },
    "check": {
      "type": "object",
      "required": ["path", "mode"],
      "properties": {
        "path": {"$ref": "#/$defs/pointer"},
        "mode": {"enum": ["exact", "subset", "contains", "absent"]},
        "expected": true,
        "owner": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "absent"}}, "required": ["mode"]},
          "then": {"not": {"required": ["expected"]}},
          "else": {"required": ["expected"]}
        }
      ],
      "additionalProperties": false
    },
    "mutation": {
      "type": "object",
      "required": ["pointer", "value"],
      "properties": {
        "pointer": {"$ref": "#/$defs/pointer"},
        "value": true
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["variant_id", "mutations", "checks"],
      "properties": {
        "variant_id": {"type": "string", "minLength": 1},
        "template": {"type": "string", "minLength": 1},
        "mutations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mutation"}},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["expectation_id", "input", "checks", "variants"],
      "properties": {
        "expectation_id": {"type": "string", "minLength": 1},
        "input": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"},
        "template": {"type": "string", "minLength": 1},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
