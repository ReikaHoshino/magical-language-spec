{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/magical-language-spec/schemas/conformance-manifest.schema.json",
  "title": "Magical language conformance manifest",
  "description": "Versioned mapping from stable conformance IDs to normative ownership and executable reference tests. Expected semantics are conformance-owned and are not generated from implementation output.",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+-[0-9]{3}$"
    },
    "classId": {
      "type": "string",
      "enum": ["Core-1.0", "Evaluator-1.0", "Adapter-lat-1.0", "Runtime-1.0"]
    },
    "ruleReference": {
      "type": "object",
      "required": ["document", "heading"],
      "properties": {
        "document": {
          "type": "string",
          "pattern": "^reference/[A-Za-z0-9._/-]+\\.md$"
        },
        "heading": {
          "type": "string",
          "pattern": "^#{1,6} .+"
        }
      },
      "additionalProperties": false
    },
    "testReference": {
      "type": "object",
      "required": ["file", "test_class", "test_method"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^tests/test_[A-Za-z0-9_]+\\.py$"
        },
        "test_class": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "test_method": {
          "type": "string",
          "pattern": "^test_[A-Za-z0-9_]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["document_kind", "schema_version", "suite", "classes", "cases"],
  "properties": {
    "document_kind": {"const": "ConformanceManifest"},
    "schema_version": {"const": "1"},
    "suite": {
      "type": "object",
      "required": ["suite_id", "suite_version", "release_target"],
      "properties": {
        "suite_id": {"const": "magical-language-conformance"},
        "suite_version": {"type": "string", "minLength": 1},
        "release_target": {"const": "v1.0.0-rc.1"}
      },
      "additionalProperties": false
    },
    "classes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "class_id",
          "status",
          "normative_references",
          "required_case_ids",
          "unsupported_or_deferred"
        ],
        "properties": {
          "class_id": {"$ref": "#/$defs/classId"},
          "status": {
            "type": "string",
            "enum": ["released", "candidate", "blocked"]
          },
          "blocked_by": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "normative_references": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/ruleReference"}
          },
          "required_case_ids": {
            "type": "array",
            "items": {"$ref": "#/$defs/stableId"},
            "uniqueItems": true
          },
          "pending_rule_areas": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "unsupported_or_deferred": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "class_ids",
          "requirement",
          "rule_refs",
          "test",
          "expected_outcome"
        ],
        "properties": {
          "case_id": {"$ref": "#/$defs/stableId"},
          "class_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/classId"},
            "uniqueItems": true
          },
          "requirement": {
            "type": "string",
            "enum": ["required", "provisional"]
          },
          "rule_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/ruleReference"}
          },
          "test": {"$ref": "#/$defs/testReference"},
          "fixtures": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "expected_outcome": {"const": "pass"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
