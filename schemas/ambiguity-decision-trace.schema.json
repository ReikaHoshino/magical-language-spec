{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/magical-language-spec/schemas/ambiguity-decision-trace.schema.json",
  "title": "Ambiguity Decision Trace V1",
  "description": "Replayable NORMALIZE-stage ambiguity decision. The trace explains candidate selection but does not prove intent, authority, conservation, identity, or other downstream safety conditions.",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "policy",
    "decision_status",
    "profile",
    "context_snapshot",
    "candidate_set",
    "ranking_evaluations",
    "selected_candidate_id",
    "rejected_candidate_ids",
    "unresolved_assumption_ids",
    "mandatory_downstream_checks",
    "diagnostics",
    "replay"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "decision_id": {"$ref": "#/$defs/nonEmptyString"},
    "policy": {"$ref": "#/$defs/policy"},
    "decision_status": {
      "enum": ["Selected", "Rejected", "PendingInteraction", "Unreproducible"]
    },
    "profile": {"$ref": "#/$defs/selectionProfile"},
    "context_snapshot": {"$ref": "#/$defs/contextSnapshot"},
    "candidate_set": {"$ref": "#/$defs/candidateSet"},
    "ranking_evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidateEvaluation"}
    },
    "selected_candidate_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/nonEmptyString"}
      ]
    },
    "rejected_candidate_ids": {"$ref": "#/$defs/identifierArray"},
    "unresolved_assumption_ids": {"$ref": "#/$defs/identifierArray"},
    "mandatory_downstream_checks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "enum": ["type", "authority", "conservation", "identity"]
      },
      "allOf": [
        {"contains": {"const": "type"}},
        {"contains": {"const": "authority"}},
        {"contains": {"const": "conservation"}},
        {"contains": {"const": "identity"}}
      ],
      "uniqueItems": true,
      "description": "Checks which remain mandatory after normalization. Presence is not a passing result."
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "replay": {"$ref": "#/$defs/replayRecord"},
    "extensions": {
      "type": "object",
      "description": "Explicit extension point. Unknown fields do not acquire ranking or safety semantics."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision_status": {"const": "Selected"}},
        "required": ["decision_status"]
      },
      "then": {
        "properties": {
          "selected_candidate_id": {"$ref": "#/$defs/nonEmptyString"}
        }
      },
      "else": {
        "properties": {
          "selected_candidate_id": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"policy": {"const": "StrictReject"}},
        "required": ["policy"]
      },
      "then": {
        "properties": {
          "decision_status": {"enum": ["Selected", "Rejected"]},
          "profile": {
            "properties": {
              "ranking_rules": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"policy": {"const": "InteractiveResolve"}},
        "required": ["policy"]
      },
      "then": {
        "properties": {
          "decision_status": {
            "enum": ["Selected", "PendingInteraction", "Unreproducible"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "properties": {
              "ranking_rules": {
                "contains": {
                  "properties": {
                    "input": {"const": "LegacyInputPosition"}
                  },
                  "required": ["input"]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {"policy": {"const": "LegacyPermissive"}}
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "properties": {
              "ranking_rules": {
                "contains": {
                  "properties": {
                    "input": {"const": "ExplicitSelection"}
                  },
                  "required": ["input"]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {"policy": {"const": "InteractiveResolve"}}
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifierArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "policy": {
      "enum": [
        "StrictReject",
        "InteractiveResolve",
        "ContextualDeterministic",
        "LegacyPermissive"
      ]
    },
    "semanticFingerprint": {
      "type": "string",
      "pattern": "^sf:v1:sha256:[0-9a-f]{64}$"
    },
    "selectionProfile": {
      "type": "object",
      "required": [
        "profile_id",
        "profile_revision",
        "ordering_revision",
        "ranking_rules",
        "final_tie_break"
      ],
      "properties": {
        "profile_id": {"$ref": "#/$defs/nonEmptyString"},
        "profile_revision": {"$ref": "#/$defs/nonEmptyString"},
        "ordering_revision": {"$ref": "#/$defs/nonEmptyString"},
        "ranking_rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/rankingRule"}
        },
        "final_tie_break": {
          "type": "array",
          "prefixItems": [
            {"const": "SemanticFingerprintAscending"},
            {"const": "CandidateIdAscending"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "Total-order fallback over admitted values. Candidate IDs MUST be stable and MUST NOT be derived from input list position."
        }
      },
      "additionalProperties": false
    },
    "rankingRule": {
      "type": "object",
      "required": [
        "rule_id",
        "input",
        "comparator",
        "missing_value",
        "evidence_required"
      ],
      "properties": {
        "rule_id": {"$ref": "#/$defs/nonEmptyString"},
        "input": {
          "enum": [
            "ExplicitSelection",
            "ContextualEvidence",
            "MorphologyCompatibility",
            "ArgumentFrameCompatibility",
            "LexicalCompatibility",
            "RegisterProfilePreference",
            "ProviderRank",
            "ProviderConfidence",
            "LegacyInputPosition"
          ]
        },
        "comparator": {
          "enum": [
            "BooleanTrueFirst",
            "BooleanFalseFirst",
            "IntegerAscending",
            "IntegerDescending",
            "StringCodePointAscending",
            "StringCodePointDescending"
          ]
        },
        "missing_value": {
          "enum": [
            "RejectCandidate",
            "RankFirst",
            "RankLast",
            "Unreproducible"
          ]
        },
        "evidence_required": {"type": "boolean"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "contextSnapshot": {
      "type": "object",
      "required": [
        "snapshot_id",
        "snapshot_revision",
        "fact_ids",
        "evidence_ids"
      ],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/nonEmptyString"},
        "snapshot_revision": {"$ref": "#/$defs/nonEmptyString"},
        "fact_ids": {"$ref": "#/$defs/identifierArray"},
        "evidence_ids": {"$ref": "#/$defs/identifierArray"}
      },
      "additionalProperties": false
    },
    "candidateSet": {
      "type": "object",
      "required": [
        "candidate_set_id",
        "candidate_set_revision",
        "input_candidate_ids",
        "canonical_candidate_ids",
        "candidates"
      ],
      "properties": {
        "candidate_set_id": {"$ref": "#/$defs/nonEmptyString"},
        "candidate_set_revision": {"$ref": "#/$defs/nonEmptyString"},
        "input_candidate_ids": {"$ref": "#/$defs/identifierArray"},
        "canonical_candidate_ids": {"$ref": "#/$defs/identifierArray"},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/candidate"}
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "semantic_fingerprint",
        "normalization_valid",
        "semantic_critical",
        "evidence_ids",
        "assumption_ids"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/nonEmptyString"},
        "semantic_fingerprint": {"$ref": "#/$defs/semanticFingerprint"},
        "normalization_valid": {"type": "boolean"},
        "semantic_critical": {"type": "boolean"},
        "evidence_ids": {"$ref": "#/$defs/identifierArray"},
        "assumption_ids": {"$ref": "#/$defs/identifierArray"}
      },
      "additionalProperties": false
    },
    "rankValue": {
      "type": ["boolean", "integer", "string", "null"]
    },
    "rankTerm": {
      "type": "object",
      "required": ["rule_id", "value", "evidence_ids"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/nonEmptyString"},
        "value": {"$ref": "#/$defs/rankValue"},
        "evidence_ids": {"$ref": "#/$defs/identifierArray"}
      },
      "additionalProperties": false
    },
    "candidateEvaluation": {
      "type": "object",
      "required": [
        "candidate_id",
        "eligible",
        "rank_terms",
        "rejection_reason_ids"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/nonEmptyString"},
        "eligible": {"type": "boolean"},
        "rank_terms": {
          "type": "array",
          "items": {"$ref": "#/$defs/rankTerm"}
        },
        "rejection_reason_ids": {"$ref": "#/$defs/identifierArray"}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "evidence_ids"],
      "properties": {
        "code": {
          "enum": [
            "AmbiguousNormalization",
            "AmbiguityInteractionRequired",
            "AmbiguityDecisionUnreproducible",
            "AmbiguityContextDrift",
            "AmbiguityReplayDivergence",
            "UnsafePermissiveNormalization",
            "UnexpectedResult"
          ]
        },
        "severity": {
          "enum": ["info", "warning", "conditional", "fatal"]
        },
        "evidence_ids": {"$ref": "#/$defs/identifierArray"}
      },
      "additionalProperties": false
    },
    "replayRecord": {
      "type": "object",
      "required": [
        "replay_status",
        "recorded_profile_revision",
        "recorded_ordering_revision",
        "recorded_context_snapshot_id",
        "recorded_context_snapshot_revision",
        "recorded_candidate_set_id",
        "recorded_candidate_set_revision",
        "recorded_selected_candidate_id",
        "recorded_selected_semantic_fingerprint",
        "diagnostic_code"
      ],
      "properties": {
        "replay_status": {
          "enum": ["NotAttempted", "Reproduced", "Diverged", "Incompatible"]
        },
        "recorded_profile_revision": {"$ref": "#/$defs/nonEmptyString"},
        "recorded_ordering_revision": {"$ref": "#/$defs/nonEmptyString"},
        "recorded_context_snapshot_id": {"$ref": "#/$defs/nonEmptyString"},
        "recorded_context_snapshot_revision": {"$ref": "#/$defs/nonEmptyString"},
        "recorded_candidate_set_id": {"$ref": "#/$defs/nonEmptyString"},
        "recorded_candidate_set_revision": {"$ref": "#/$defs/nonEmptyString"},
        "recorded_selected_candidate_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonEmptyString"}
          ]
        },
        "recorded_selected_semantic_fingerprint": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/semanticFingerprint"}
          ]
        },
        "diagnostic_code": {
          "enum": [
            null,
            "AmbiguityDecisionUnreproducible",
            "AmbiguityContextDrift",
            "AmbiguityReplayDivergence"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
