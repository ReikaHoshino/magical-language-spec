{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/magical-language-spec/schemas/estimator-profile.schema.json",
  "title": "Energy, resource, and timing estimator profile",
  "description": "Revisioned estimator/model ownership contract. Estimates remain planning or feasibility evidence; they do not rewrite source semantics or satisfy mandatory obligations.",
  "type": "object",
  "required": [
    "metadata",
    "profile_kind",
    "scope",
    "runtime_profile_requirement",
    "models",
    "reference_cases"
  ],
  "properties": {
    "metadata": {"$ref": "artifact-metadata.schema.json"},
    "profile_kind": {
      "enum": ["SyntheticReference", "Deployment"]
    },
    "scope": {"$ref": "#/$defs/profileScope"},
    "runtime_profile_requirement": {
      "$ref": "#/$defs/runtimeProfileRequirement"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    },
    "reference_cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/referenceCase"}
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"profile_kind": {"const": "SyntheticReference"}},
        "required": ["profile_kind"]
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "use": {"const": "SyntheticFixtureOnly"},
              "values_are_universal_world_constants": {"const": false}
            },
            "required": ["use", "values_are_universal_world_constants"]
          },
          "reference_cases": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "definitionSource": {
      "enum": ["Implementation", "Registry", "World", "Profile"]
    },
    "profileScope": {
      "type": "object",
      "required": [
        "use",
        "values_are_universal_world_constants",
        "statement"
      ],
      "properties": {
        "use": {
          "enum": ["SyntheticFixtureOnly", "Reference", "Deployment"]
        },
        "values_are_universal_world_constants": {"type": "boolean"},
        "statement": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifactReference": {
      "type": "object",
      "required": ["artifact_id", "revision"],
      "properties": {
        "artifact_id": {
          "$ref": "common-values.schema.json#/$defs/identifier"
        },
        "revision": {
          "$ref": "common-values.schema.json#/$defs/revision"
        }
      },
      "additionalProperties": false
    },
    "runtimeProfileRequirement": {
      "type": "object",
      "required": [
        "profile",
        "compatibility_profile",
        "physical_time_is_runtime_tick"
      ],
      "properties": {
        "profile": {"$ref": "#/$defs/artifactReference"},
        "compatibility_profile": {
          "$ref": "compatibility.schema.json#/$defs/profileReference"
        },
        "physical_time_is_runtime_tick": {"const": false}
      },
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "required": [
        "definition_source",
        "owner_id",
        "revision",
        "evidence_ids"
      ],
      "properties": {
        "definition_source": {"$ref": "#/$defs/definitionSource"},
        "owner_id": {
          "$ref": "common-values.schema.json#/$defs/identifier"
        },
        "revision": {
          "$ref": "common-values.schema.json#/$defs/revision"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common-values.schema.json#/$defs/identifier"
          }
        }
      },
      "additionalProperties": false
    },
    "energyDimension": {
      "const": {
        "kg": 1,
        "m": 2,
        "s": -2,
        "A": 0,
        "K": 0,
        "mol": 0,
        "cd": 0
      }
    },
    "timeDimension": {
      "const": {
        "kg": 0,
        "m": 0,
        "s": 1,
        "A": 0,
        "K": 0,
        "mol": 0,
        "cd": 0
      }
    },
    "outputContract": {
      "type": "object",
      "required": ["semantic_type", "dimension", "unit"],
      "properties": {
        "semantic_type": {
          "$ref": "common-values.schema.json#/$defs/identifier"
        },
        "dimension": {
          "$ref": "common-values.schema.json#/$defs/siDimension"
        },
        "unit": {"$ref": "common-values.schema.json#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "coefficient": {
      "type": "object",
      "required": [
        "coefficient_id",
        "owner",
        "value",
        "fixture_only"
      ],
      "properties": {
        "coefficient_id": {
          "$ref": "common-values.schema.json#/$defs/identifier"
        },
        "owner": {"$ref": "#/$defs/owner"},
        "value": {"$ref": "common-values.schema.json#/$defs/quantity"},
        "fixture_only": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "availability": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status"],
          "properties": {"status": {"const": "Available"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "reason", "unknown_classification"],
          "properties": {
            "status": {"const": "Unavailable"},
            "reason": {"type": "string", "minLength": 1},
            "unknown_classification": {
              "enum": ["ModelDependent", "Unavailable"]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "modelReference": {
      "type": "object",
      "required": ["model_id", "revision"],
      "properties": {
        "model_id": {
          "$ref": "common-values.schema.json#/$defs/identifier"
        },
        "revision": {
          "$ref": "common-values.schema.json#/$defs/revision"
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "model_id",
        "revision",
        "domain",
        "category",
        "owner",
        "availability",
        "input_contract",
        "output_contract"
      ],
      "properties": {
        "model_id": {
          "$ref": "common-values.schema.json#/$defs/identifier"
        },
        "revision": {
          "$ref": "common-values.schema.json#/$defs/revision"
        },
        "domain": {"enum": ["Energy", "Resource", "Timing"]},
        "category": {
          "oneOf": [
            {
              "enum": [
                "physical_work",
                "reaction_or_thermodynamic",
                "channel_open",
                "channel_maintenance",
                "control",
                "observation_information",
                "synchronization",
                "losses",
                "reserved_margin",
                "physical_duration"
              ]
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:[A-Za-z0-9_.-]+$"
            }
          ]
        },
        "owner": {"$ref": "#/$defs/owner"},
        "availability": {"$ref": "#/$defs/availability"},
        "input_contract": {
          "type": "object",
          "required": ["required_fields"],
          "properties": {
            "required_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        },
        "output_contract": {"$ref": "#/$defs/outputContract"},
        "evaluation_rule": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "coefficient_id"],
              "properties": {
                "kind": {"const": "SyntheticFixedCoefficient"},
                "coefficient_id": {
                  "$ref": "common-values.schema.json#/$defs/identifier"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "rule_id", "revision", "owner"],
              "properties": {
                "kind": {"const": "OwnedModel"},
                "rule_id": {
                  "$ref": "common-values.schema.json#/$defs/identifier"
                },
                "revision": {
                  "$ref": "common-values.schema.json#/$defs/revision"
                },
                "owner": {"$ref": "#/$defs/owner"}
              },
              "additionalProperties": false
            }
          ]
        },
        "coefficients": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/coefficient"}
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "properties": {"status": {"const": "Available"}},
                "required": ["status"]
              }
            },
            "required": ["availability"]
          },
          "then": {"required": ["evaluation_rule", "coefficients"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["evaluation_rule"]},
                {"required": ["coefficients"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {"domain": {"const": "Energy"}},
            "required": ["domain"]
          },
          "then": {
            "properties": {
              "category": {
                "enum": [
                  "physical_work",
                  "reaction_or_thermodynamic",
                  "channel_open",
                  "channel_maintenance",
                  "control",
                  "observation_information",
                  "synchronization",
                  "losses",
                  "reserved_margin"
                ]
              },
              "output_contract": {
                "properties": {
                  "semantic_type": {"const": "Energy"},
                  "dimension": {"$ref": "#/$defs/energyDimension"},
                  "unit": {"const": "J"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"domain": {"const": "Timing"}},
            "required": ["domain"]
          },
          "then": {
            "properties": {
              "category": {"const": "physical_duration"},
              "output_contract": {
                "properties": {
                  "semantic_type": {"const": "Time"},
                  "dimension": {"$ref": "#/$defs/timeDimension"},
                  "unit": {"const": "s"}
                }
              }
            }
          }
        }
      ]
    },
    "quantityEstimate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value", "uncertainty", "evidence_ids"],
          "properties": {
            "kind": {"const": "Exact"},
            "value": {"$ref": "common-values.schema.json#/$defs/quantity"},
            "uncertainty": {"type": "string", "minLength": 1},
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-values.schema.json#/$defs/identifier"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "min", "max", "uncertainty", "evidence_ids"],
          "properties": {
            "kind": {"const": "Range"},
            "min": {"$ref": "common-values.schema.json#/$defs/quantity"},
            "max": {"$ref": "common-values.schema.json#/$defs/quantity"},
            "uncertainty": {"type": "string", "minLength": 1},
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-values.schema.json#/$defs/identifier"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value", "uncertainty", "evidence_ids"],
          "properties": {
            "kind": {"const": "LowerBound"},
            "value": {"$ref": "common-values.schema.json#/$defs/quantity"},
            "uncertainty": {"type": "string", "minLength": 1},
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-values.schema.json#/$defs/identifier"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value", "uncertainty", "evidence_ids"],
          "properties": {
            "kind": {"const": "UpperBound"},
            "value": {"$ref": "common-values.schema.json#/$defs/quantity"},
            "uncertainty": {"type": "string", "minLength": 1},
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-values.schema.json#/$defs/identifier"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "summary", "uncertainty", "evidence_ids"],
          "properties": {
            "kind": {"const": "Distribution"},
            "summary": {"type": "object"},
            "uncertainty": {"type": "string", "minLength": 1},
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-values.schema.json#/$defs/identifier"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reason", "classification", "evidence_ids"],
          "properties": {
            "kind": {"const": "Unknown"},
            "reason": {"type": "string", "minLength": 1},
            "classification": {
              "enum": ["ModelDependent", "Unavailable", "Indeterminate"]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "$ref": "common-values.schema.json#/$defs/identifier"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "adoption": {
      "type": "object",
      "required": [
        "inference_record_id",
        "criticality",
        "planning_assumption_id",
        "binding"
      ],
      "properties": {
        "inference_record_id": {
          "$ref": "common-values.schema.json#/$defs/identifier"
        },
        "criticality": {"const": "EstimateAllowed"},
        "planning_assumption_id": {
          "$ref": "common-values.schema.json#/$defs/identifier"
        },
        "binding": {
          "$ref": "planning-inference.schema.json#/$defs/binding"
        }
      },
      "additionalProperties": false
    },
    "mandatoryObligation": {
      "type": "object",
      "required": ["kind", "status"],
      "properties": {
        "kind": {
          "enum": ["Type", "Identity", "Conservation", "Authority", "Lease"]
        },
        "status": {"const": "Indeterminate"}
      },
      "additionalProperties": false
    },
    "referenceCase": {
      "type": "object",
      "required": [
        "case_id",
        "model",
        "source_before",
        "source_after",
        "estimate",
        "mandatory_obligations"
      ],
      "properties": {
        "case_id": {
          "$ref": "common-values.schema.json#/$defs/identifier"
        },
        "model": {"$ref": "#/$defs/modelReference"},
        "source_before": {
          "$ref": "planning-inference.schema.json#/$defs/sourceValue"
        },
        "source_after": {
          "$ref": "planning-inference.schema.json#/$defs/sourceValue"
        },
        "estimate": {"$ref": "#/$defs/quantityEstimate"},
        "adoption": {"$ref": "#/$defs/adoption"},
        "mandatory_obligations": {
          "type": "array",
          "items": {"$ref": "#/$defs/mandatoryObligation"}
        },
        "runtime_context": {
          "type": "object",
          "required": ["runtime_profile", "physical_time_is_runtime_tick"],
          "properties": {
            "runtime_profile": {"$ref": "#/$defs/artifactReference"},
            "runtime_tick_id": {
              "$ref": "common-values.schema.json#/$defs/identifier"
            },
            "physical_time_is_runtime_tick": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
