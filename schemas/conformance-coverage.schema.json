{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/magical-language-spec/schemas/conformance-coverage.schema.json",
  "title": "Conformance rule coverage inventory",
  "type": "object",
  "required": ["document_kind", "schema_version", "suite_version", "rules"],
  "properties": {
    "document_kind": {"const": "ConformanceRuleCoverage"},
    "schema_version": {"const": "1"},
    "suite_version": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "class_id", "document", "heading", "status"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^CONF-RULE-[A-Z0-9-]+$"},
          "class_id": {"enum": ["Core-1.0", "Evaluator-1.0", "Adapter-lat-1.0", "Runtime-1.0"]},
          "document": {"type": "string", "pattern": "^reference/[A-Za-z0-9._/-]+\\.md$"},
          "heading": {"type": "string", "pattern": "^#{1,6} .+"},
          "status": {"enum": ["covered", "deferred", "non-executable"]},
          "case_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "rationale": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "covered"}}, "required": ["status"]},
            "then": {"required": ["case_ids"], "properties": {"case_ids": {"minItems": 1}}}
          },
          {
            "if": {"properties": {"status": {"enum": ["deferred", "non-executable"]}}, "required": ["status"]},
            "then": {"required": ["rationale"]}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
