{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/magical-language-spec/schemas/artifact-envelope.schema.json",
  "title": "Experimental Artifact Envelope v0",
  "type": "object",
  "required": ["artifact_kind", "artifact_version", "instance_id", "provenance"],
  "properties": {
    "artifact_kind": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "pattern": "^[0-9]+$"},
    "instance_id": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["definition_sources"],
      "properties": {
        "definition_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "generator": {"type": ["string", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
